# PDF figures (duplicates of PNGs)
new-phase-results/**/*.pdf

# PyTorch activation tensors (large binary artifacts, >100MB each)
new-phase-results/**/*.pt

# Large per-item raw result files (keep summaries, skip raw JSONL)
new-phase-results/**/*_results.jsonl

# Large experiment result subdirs (raw inference output, >50MB)
new-phase-results/llama-3.1-8b-results/exp12_instruct/
new-phase-results/llama-3.1-8b-results/exp12_k/
new-phase-results/llama-3.1-8b-results/exp12_p0/
