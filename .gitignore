new-phase-results/qwen3-4b-results/exp13/

# Checkpoint / manifest files (run artifacts, not results)
new-phase-results/**/*_checkpoint.json
new-phase-results/**/*_checkpoint_records.jsonl
new-phase-results/**/*_run_manifest.json

# Watch-script runtime artifacts (PID files, stdout redirects, rolling logs)
new-phase-results/**/*.pid
new-phase-results/**/*.out
new-phase-results/**/*.log

# Smoke / sanity-test result directories (not archival results)
new-phase-results/**/*_smoke/
new-phase-results/**/smoke_*/

